# Yalidine webhook signing secret (server-only)
YALIDINE_WEBHOOK_SECRET=

# Supabase service-role key (server-only; never use NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=

# Protects the scheduled stale-image cleanup endpoint (set the same value in Vercel)
CRON_SECRET=

# Sentry DSN (public project key; set in Vercel Production and Preview)
NEXT_PUBLIC_SENTRY_DSN=

# Optional Sentry source-map upload settings (server-only; never expose the auth token)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
