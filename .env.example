# Public Supabase configuration. The anon key is intended for browser use;
# database access must be protected by Supabase Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only configuration. Never add the NEXT_PUBLIC_ prefix.
ADMIN_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
